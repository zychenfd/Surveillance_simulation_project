<beast version="10.5.0">
	

	<!-- The list of taxa to be analysed (can also include dates/ages).          -->
	<!-- ntax=[SeqNrHere]                                                                -->
	<taxa id="taxa">
[TaxaSetHere]		
	</taxa>
	
	

	<!-- The sequence alignment (each sequence refers to a taxon above).         -->
	<!-- ntax=[SeqNrHere] nchar=[SeqLengthHere]                                                     -->
	<alignment id="alignment" dataType="nucleotide">
[AlignmentHere]		
	</alignment>


	<!-- The unique patterns from 1 to end                                       -->
	<patterns id="patterns" from="1" strip="false">
		<alignment idref="alignment"/>
	</patterns>
	

	<!-- general data type for discrete trait model, 'geo'                 -->
	<generalDataType id="geo.dataType">

		<!-- Number Of States = [NrOfStatesHere]                                                    -->
[StateCodeHere]
	</generalDataType>	


	<!-- Data pattern for discrete trait, 'geo'                            -->
	<attributePatterns id="geo.pattern" attribute="geo">
		<taxa idref="taxa"/>
		<generalDataType idref="geo.dataType"/>
	</attributePatterns>


	<!-- A prior assumption that the population size has remained constant       -->
	<!-- throughout the time spanned by the genealogy.                           -->
	<constantSize id="constant" units="years">
		<populationSize>
			<parameter id="constant.popSize" value="1.0" lower="0.0"/>
		</populationSize>
	</constantSize>
	

	<!-- Generate a random starting tree under the coalescent process            -->
	<coalescentSimulator id="startingTree">
		<taxa idref="taxa"/>
		<constantSize idref="constant"/>
	</coalescentSimulator>
	

	<!-- Generate a tree model                                                   -->
	<treeModel id="treeModel">
		<coalescentTree idref="startingTree"/>
		<rootHeight>
			<parameter id="treeModel.rootHeight"/>
		</rootHeight>
		<nodeHeights internalNodes="true">
			<parameter id="treeModel.internalNodeHeights"/>
		</nodeHeights>
		<nodeHeights internalNodes="true" rootNode="true">
			<parameter id="treeModel.allInternalNodeHeights"/>
		</nodeHeights>
	</treeModel>

	<!-- Statistic for height of the root of the tree                            -->
	<treeHeightStatistic id="rootHeight">
		<treeModel idref="treeModel"/>
	</treeHeightStatistic>

	<!-- Statistic for sum of the branch lengths of the tree (tree length)       -->
	<treeLengthStatistic id="treeLength">
		<treeModel idref="treeModel"/>
	</treeLengthStatistic>

	<!-- Statistic for time of most recent common ancestor of tree               -->
	<tmrcaStatistic id="age(root)" absolute="true">
		<treeModel idref="treeModel"/>
	</tmrcaStatistic>
	
	
	<!-- The strict clock (Uniform rates across branches)                        -->
	<strictClockBranchRates id="default.branchRates">
		<rate>
			<parameter id="default.clock.rate" value="0.01" lower="0.0"/>
		</rate>
	</strictClockBranchRates>
	
	<!-- The strict clock (Uniform rates across branches)                        -->
	<strictClockBranchRates id="geo.branchRates">
		<rate>
			<parameter id="geo.clock.rate" value="0.001" lower="0.0"/>
		</rate>
	</strictClockBranchRates>
	

	<!-- The HKY substitution model (Hasegawa, Kishino & Yano, 1985)             -->
	<HKYModel id="hky">
		<frequencies>
			<frequencyModel dataType="nucleotide">
				<frequencies>
					<parameter id="frequencies" value="0.25 0.25 0.25 0.25"/>
				</frequencies>
			</frequencyModel>
		</frequencies>
		<kappa>
			<parameter id="kappa" value="2.0" lower="0.0"/>
		</kappa>
	</HKYModel>

	<!-- site model                                                              -->
	<siteModel id="siteModel">
		<substitutionModel>
			<HKYModel idref="hky"/>
		</substitutionModel>
		<gammaShape gammaCategories="4">
			<parameter id="alpha" value="0.5" lower="0.0"/>
		</gammaShape>
	</siteModel>

	<!--                                                                         -->
	<statistic id="mu" name="mu">
		<siteModel idref="siteModel"/>
	</statistic>
	

	<!-- Likelihood for tree given sequence data                                 -->
	<treeDataLikelihood id="treeLikelihood" useAmbiguities="false" usePreOrder="false">
		<patterns idref="patterns"/>
		<treeModel idref="treeModel"/>
		<siteModel idref="siteModel"/>
		<strictClockBranchRates idref="default.branchRates"/>
	</treeDataLikelihood>
	
	<!-- START Discrete Traits Model                                             -->

	
	<!-- asymmetric BASTA model for discrete state reconstructions                -->
	<complexSubstitutionModel id="geo.model" randomizeIndicator="false" normalized="true" scaleRatesByFrequencies="true">
		<generalDataType idref="geo.dataType"/>
		<frequencies>
			<frequencyModel id="geo.frequencyModel" normalize="true">
				<generalDataType idref="geo.dataType"/>
				<frequencies>
					<parameter id="geo.frequencies" value="1.0" dimension="[FreqDimHere]"/>
				</frequencies>
			</frequencyModel>
		</frequencies>

		<!-- rates                                                   -->
		<rates>
			<parameter id="geo.rates" dimension="[RateDimHere]" value="1.0"/>
		</rates>
	</complexSubstitutionModel>
	
	<siteModel id="geo.siteModel">
		<substitutionModel>
			<complexSubstitutionModel idref="geo.model"/>
		</substitutionModel>
	</siteModel>
	
	<!-- PER-DEME exponential growth: each deme d has its own trajectory              -->
	<parameter id="structured.popSizes" dimension="[FreqDimHere]" value="1.0" lower="0.0"/>
    <duplicatedParameter id="structured.growthRates">
        <parameter id="growthRates" value="0.0"/>
        <copies>
           <parameter value="[FreqDimHere]"/>
        </copies>
    </duplicatedParameter>

	<structuredCoalescent type="BASTA" id="geo.treeLikelihood" stateTagName="geo.states" useAmbiguities="true">
		<attributePatterns idref="geo.pattern"/>
		<treeModel idref="treeModel"/>
		<siteModel idref="geo.siteModel"/>
		<complexSubstitutionModel idref="geo.model"/>
		<strictClockBranchRates idref="geo.branchRates"/>
		<popSizes>
			<parameter idref="structured.popSizes"/>
		</popSizes>
		<growthRates>
			<parameter idref="structured.growthRates"/>
		</growthRates>
	</structuredCoalescent>

	<!-- END Discrete Traits Model                                               -->


	<!-- Define operators                                                        -->
	<operators id="operators" optimizationSchedule="log">
		<scaleOperator scaleFactor="0.75" weight="1">
			<parameter idref="kappa"/>
		</scaleOperator>
		<deltaExchange delta="0.01" weight="1">
			<parameter idref="frequencies"/>
		</deltaExchange>
		<scaleOperator scaleFactor="0.75" weight="1">
			<parameter idref="alpha"/>
		</scaleOperator>
		<scaleOperator scaleFactor="0.75" weight="3">
			<parameter idref="default.clock.rate"/>
		</scaleOperator>
		<upDownOperator scaleFactor="0.75" weight="3">
			<up>
				<parameter idref="treeModel.allInternalNodeHeights"/>
			</up>
			<down>
				<parameter idref="default.clock.rate"/>
			</down>
		</upDownOperator>

		<subtreeSlide size="1.0" gaussian="true" weight="30">
			<treeModel idref="treeModel"/>
		</subtreeSlide>
		<narrowExchange weight="30">
			<treeModel idref="treeModel"/>
		</narrowExchange>
		<wideExchange weight="3">
			<treeModel idref="treeModel"/>
		</wideExchange>
		<wilsonBalding weight="3">
			<treeModel idref="treeModel"/>
		</wilsonBalding>
		<scaleOperator scaleFactor="0.75" weight="3">
			<parameter idref="treeModel.rootHeight"/>
		</scaleOperator>
		<uniformOperator weight="30">
			<parameter idref="treeModel.internalNodeHeights"/>
		</uniformOperator>

		<scaleOperator scaleFactor="0.75" weight="3">
			<parameter idref="geo.clock.rate"/>
		</scaleOperator>
		<upDownOperator scaleFactor="0.75" weight="3">
			<up>
				<parameter idref="treeModel.allInternalNodeHeights"/>
			</up>
			<down>
				<parameter idref="geo.clock.rate"/>
			</down>
		</upDownOperator>
		<scaleOperator scaleFactor="0.75" weight="15" scaleAllIndependently="true">
			<parameter idref="geo.rates"/>
		</scaleOperator>
				
		<scaleOperator scaleFactor="0.75" weight="3">
			<parameter idref="structured.popSizes"/>
		</scaleOperator>
		<randomWalkOperator windowSize="1.0" weight="3" autoOptimize="true">
			<parameter idref="growthRates"/>
		</randomWalkOperator>

	</operators>
	

	<!-- Define MCMC                                                             -->
	<mcmc id="mcmc" chainLength="[ChainLengthHere]" autoOptimize="true">
		<joint id="joint">
			<prior id="prior">
				<logNormalPrior mu="1.0" sigma="1.25" offset="0.0">
					<parameter idref="kappa"/>
				</logNormalPrior>
				<dirichletPrior alpha="1.0" sumsTo="1.0">
					<parameter idref="frequencies"/>
				</dirichletPrior>
				<exponentialPrior mean="0.5" offset="0.0">
					<parameter idref="alpha"/>
				</exponentialPrior>
				<normalPrior mean="0.01" stdev="0.001">
					<parameter idref="default.clock.rate"/>
				</normalPrior>
				<gammaPrior shape="1.0" scale="1.0" offset="0.0">
					<parameter idref="geo.clock.rate"/>
				</gammaPrior>

				<uniformPrior lower="0.0" upper="1.0">
					<parameter idref="geo.frequencies"/>
				</uniformPrior>
				<cachedPrior>
					<gammaPrior shape="1.0" scale="1.0" offset="0.0">
						<parameter idref="geo.rates"/>
					</gammaPrior>
					<parameter idref="geo.rates"/>
				</cachedPrior>
				<gammaPrior shape="0.001" scale="1000.0" offset="0.0">
					<parameter idref="structured.popSizes"/>
				</gammaPrior>
				<laplacePrior mean="0.0" scale="100.0">
					<parameter idref="growthRates"/>
				</laplacePrior>
				
				<strictClockBranchRates idref="default.branchRates"/>
				<strictClockBranchRates idref="geo.branchRates"/>
			</prior>
			<likelihood id="likelihood">
				<treeLikelihood idref="treeLikelihood"/>
				<structuredCoalescent idref="geo.treeLikelihood"/>
			</likelihood>
		</joint>
		<operators idref="operators"/>

		<!-- write log to screen                                                     -->
		<log id="screenLog" logEvery="1000">
			<column label="Joint" dp="4" width="12">
				<joint idref="joint"/>
			</column>
			<column label="Prior" dp="4" width="12">
				<prior idref="prior"/>
			</column>
			<column label="Likelihood" dp="4" width="12">
				<likelihood idref="likelihood"/>
			</column>
			<column label="age(root)" sf="6" width="12">
				<tmrcaStatistic idref="age(root)"/>
			</column>
			<column label="default.clock.rate" sf="6" width="12">
				<parameter idref="default.clock.rate"/>
			</column>
		</log>

		<!-- write log to file                                                       -->
		<log id="fileLog" logEvery="[fileLogEveryHere]" fileName="[LogFileNameHere].log" overwrite="false">
			<joint idref="joint"/>
			<prior idref="prior"/>
			<likelihood idref="likelihood"/>
			<treeHeightStatistic idref="rootHeight"/>
			<tmrcaStatistic idref="age(root)"/>
			<treeLengthStatistic idref="treeLength"/>
			<parameter idref="kappa"/>
			<parameter idref="frequencies"/>
			<parameter idref="alpha"/>
			<parameter idref="default.clock.rate"/>
			<parameter idref="geo.clock.rate"/>
			
			<!-- START Discrete Traits Model                                             -->
			<parameter idref="geo.rates"/>
			<parameter idref="structured.popSizes"/>
			<parameter idref="structured.growthRates"/>

			<!-- END Discrete Traits Model                                               -->

			<treeLikelihood idref="treeLikelihood"/>
			<structuredCoalescent idref="geo.treeLikelihood"/>

			<strictClockBranchRates idref="default.branchRates"/>
			<strictClockBranchRates idref="geo.branchRates"/>
			
		</log>

		<!-- Ancestral state reconstruction for: geo                           -->
		<log id="fileLog_geo" logEvery="2000" fileName="[LogFileNameHere].geo.states.log">
			<ancestralTrait name="geo" traitName="geo.states">
				<treeModel idref="treeModel"/>
				<structuredCoalescent idref="geo.treeLikelihood"/>
			</ancestralTrait>
		</log>

		<!-- write tree log to file                                                  -->
		<logTree id="treeFileLog" logEvery="[treefileLogEveryHere]" nexusFormat="true" fileName="[LogFileNameHere].trees" sortTranslationTable="true">
			<treeModel idref="treeModel"/>
			<joint idref="joint"/>
            <trait name="geo.states" tag="geo">
				<structuredCoalescent idref="geo.treeLikelihood"/>
			</trait>
		</logTree>

	</mcmc>
	
	<report>
		<property name="timer">
			<mcmc idref="mcmc"/>
		</property>
	</report>
	
</beast>
